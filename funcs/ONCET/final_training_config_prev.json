{
    "data": {
        "h5_path": "data/seizure_data.h5",
        "train_patient_ids": null,
        "val_patient_ids": null,
        "test_patient_ids": null,
        "batch_size": 512,
        "num_workers": 16,
        "combine_onset_spread": true
    },
    "model": {
        "num_classes": 2,
        "base_filters": 24,
        "num_blocks": 4,
        "kernel_size": 16,
        "dilations": [
            2,
            4,
            8,
            16
        ],
        "dropout_stem": 0.1,
        "dropout_blocks": 0.13277600241636808,
        "dropout_head": 0.4303921550345198
    },
    "training": {
        "optimizer": "adamw",
        "learning_rate": 0.002503150176811048,
        "weight_decay": 0.00016550765152570224,
        "betas": [
            0.9,
            0.999
        ],
        "scheduler": "plateau",
        "max_lr": null,
        "pct_start": 0.3,
        "criterion": "cross_entropy",
        "label_smoothing": 0.042232974486504815,
        "use_class_weights": true,
        "num_epochs": 200,
        "grad_clip": 1.0,
        "early_stopping_patience": 10,
        "device": "cuda",
        "mixed_precision": true
