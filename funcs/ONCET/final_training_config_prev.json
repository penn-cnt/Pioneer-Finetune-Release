    "cv": {
        "n_folds": 5,
        "n_trials": 50,
        "max_epochs_per_trial": 30,
        "early_stopping_patience": 5,
        "random_state": 42,
        "study_name": "seizure_detection_cv",
        "downsample_ratio": 0.2
    },
    "evaluation": {
        "find_optimal_threshold": true,
        "threshold_metric": "f2",
        "generate_plots": true
